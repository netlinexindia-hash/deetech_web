# DeeTech Group — environment template
#
# Copy to `.env` for local development and fill in real values.
# `.env` is git-ignored and MUST NEVER be committed.
# Production values are supplied on the VPS, not from this file.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# These three are consumed by the `db` service in docker-compose.yml.
POSTGRES_DB=deetech
POSTGRES_USER=deetech
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-local-only

# The API connects over the private Docker network, so the host is the service
# name `db`, not localhost. Postgres is never published to the public internet.
DATABASE_URL=postgresql://deetech:change-me-local-only@db:5432/deetech

# When running `npm run dev:api` on the host instead of in Docker, use:
# DATABASE_URL=postgresql://deetech:change-me-local-only@localhost:5432/deetech

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API.
# In production both apps sit behind one nginx hostname, so this is usually
# just the public site origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# NOTE: Next.js loads env files from apps/web, not from here, so these two are
# for docker-compose. For local `npm run dev` the code already defaults to
# localhost:4000 and localhost:3000, so no web env file is needed.
#
# Server-side base URL the Next.js server uses to reach the API.
# Inside Docker this is the service name; on the host it is localhost.
API_BASE_URL=http://api:4000

# Public canonical origin. Used for canonical tags, sitemap.xml, robots.txt
# and Open Graph URLs. NEXT_PUBLIC_* values are inlined into the browser
# bundle — never put a secret behind this prefix.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# At least 32 characters. Used to key the HMAC that hashes session ids and
# client IPs, so changing it signs every admin out and makes existing IP
# hashes uncomparable. Required in production — the API refuses to start
# without it.
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-generate-a-long-random-value

# How long an admin session lasts.
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Outbound email for enquiry notifications
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty and the mailer becomes a no-op that logs a warning.
# Enquiries are still saved to the database and still appear in the admin
# list — only the notification email is skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="DeeTech Group <no-reply@deetechgroup.com>"
ENQUIRY_NOTIFICATION_TO=support@deetechgroup.com

# ---------------------------------------------------------------------------
# Media storage (Week 4, Day 20)
# ---------------------------------------------------------------------------
# Container path backed by a persistent Docker volume. A disposable container
# layer is not acceptable storage for uploads.
MEDIA_STORAGE_PATH=/var/lib/deetech/media
MEDIA_MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# Analytics (Week 6, Day 28)
# ---------------------------------------------------------------------------
# Leave empty to disable. The current WordPress site has no analytics at all,
# so there is no historical baseline to preserve — see SEO-7 in the Day 1 audit.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Enquiry throttling
# ---------------------------------------------------------------------------
# A second layer behind nginx's limit_req: how many enquiries one source may
# send per window before the API refuses with 429.
ENQUIRY_MAX_PER_WINDOW=5
ENQUIRY_WINDOW_MINUTES=60
